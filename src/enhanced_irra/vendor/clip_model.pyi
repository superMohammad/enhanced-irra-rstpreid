"""Typed boundary for the pinned, unmodified upstream PyTorch interfaces."""
from torch import Tensor, nn

class QuickGELU(nn.Module):
    def forward(self, x: Tensor) -> Tensor: ...
class LayerNorm(nn.LayerNorm):
    def forward(self, x: Tensor) -> Tensor: ...
class MLP(nn.Sequential):
    c_fc: nn.Linear
    c_proj: nn.Linear
class ResidualAttentionBlock(nn.Module):
    attn: nn.MultiheadAttention
    mlp: MLP
class Transformer(nn.Module):
    resblocks: nn.Sequential
    def __init__(self, width: int, layers: int, heads: int) -> None: ...
    def forward(self, x: Tensor) -> Tensor: ...
class CLIP(nn.Module):
    def __init__(self, embed_dim: int, image_resolution: tuple[int, int], vision_layers: int, vision_width: int, vision_patch_size: int, stride_size: int, context_length: int, vocab_size: int, transformer_width: int, transformer_heads: int, transformer_layers: int) -> None: ...
    def encode_image(self, images: Tensor) -> Tensor: ...
    def encode_text(self, ids: Tensor) -> Tensor: ...
