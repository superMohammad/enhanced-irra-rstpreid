  "sdm_weight": 1.0,
  "id_weight": 1.0,
  "mlm_weight": 0.0,
  "masking": "random",
  "mask_probability": 0.15,
  "frequency_weighted": false,
  "frequency_power": 2.0,
  "retrieval_input": "clean",
  "train_id_limit": 0,
  "max_steps": 0,
  "cross_depth": 4,
  "image_height": 384,
  "image_width": 128,
  "precision": "bfloat16"
