{
  "name": "A1_SDM_ID",
  "mode": "FULL_TRAIN",
  "seed": 43,
  "device": "cuda",
  "dataset": "data/RSTPReid",
  "quarantine_manifest": "configs/quarantine.json",
  "pretrained": "weights/ViT-B-16.pt",
  "output": "outputs/full",
  "epochs": 60,
  "batch_size": 64,
  "accumulation": 1,
  "workers": 4,
